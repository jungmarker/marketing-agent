# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# Meta / Facebook
FACEBOOK_ACCESS_TOKEN=your_page_access_token_here
FACEBOOK_PAGE_ID=your_page_id_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# AgentOS API (fsbo-agent backend)
AGENTOS_BASE_URL=http://localhost:8000
AGENTOS_API_KEY=optional_if_you_add_auth

# Review mode: "draft" (save to file, review before posting) or "auto" (post directly)
POSTING_MODE=draft

# Scheduling (24h format, local time)
DAILY_RUN_HOUR=9
DAILY_RUN_MINUTE=0

# Baltimore market focus
PRIMARY_MARKET=Baltimore City, MD
SECONDARY_MARKETS=Montgomery County,Prince George's County,Baltimore County
